# ============================================================
# HireMind AI — Production Environment Variables Reference
# ============================================================
# Copy this file to .env.local (frontend) or set these in Railway/Vercel dashboards.
# DO NOT commit actual secret values to version control.
# ============================================================

# -----------------------------------------------------------
# BACKEND (Railway) — Set these in Railway service variables
# -----------------------------------------------------------

# Application
ENVIRONMENT=production
DEBUG=False
SERVICE_NAME=hiremind-api-gateway

# Authentication — CHANGE THIS in production!
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — Set to your Vercel deployment URL (comma-separated)
# Example: https://hiremind.vercel.app,https://hiremind-git-main-kritak0808.vercel.app
CORS_ORIGINS=https://your-project.vercel.app

# Database — Railway PostgreSQL plugin injects DATABASE_URL automatically
# Supports postgres://, postgresql://, and postgresql+asyncpg:// formats
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis — Railway Redis plugin injects REDIS_URL automatically
# If not set, realtime features degrade gracefully (app still works)
REDIS_URL=redis://default:password@host:6379

# Vector Search (optional)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Feature Flags
ENABLE_AI_VOICE_STREAMING=True
ENABLE_REALTIME_TELEMETRY=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# -----------------------------------------------------------
# FRONTEND (Vercel) — Set these in Vercel project settings
# -----------------------------------------------------------

# REQUIRED: The Railway backend URL (no trailing slash)
# Example: https://hiremind-production.up.railway.app
NEXT_PUBLIC_API_URL=https://your-railway-backend.up.railway.app
