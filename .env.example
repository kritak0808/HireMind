# ==============================================================================
# HIREMIND AI LOCALHOST ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# --- Gateway & Environment ---
DEBUG=true
PORT=8000
SECRET_KEY=super-secret-key-signature-token-hash-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Databases ---
DATABASE_URL=postgresql+asyncpg://hiremind_user:hiremind_password@localhost:5432/hiremind_db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Storage (MinIO S3 Compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_admin_password
MINIO_SECURE=false
MINIO_BUCKET_NAME=hiremind-assets

# --- SMTP Mail Testing (Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test_sender
SMTP_PASSWORD=test_password
SMTP_FROM=noreply@hiremind.ai

# --- Monitoring & Tracing ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PATH=/metrics

# --- AI Providers Mocks ---
GEMINI_API_KEY=mock-gemini-key-1234
OPENAI_API_KEY=mock-openai-key-5678
COHERE_API_KEY=mock-cohere-key-9012
